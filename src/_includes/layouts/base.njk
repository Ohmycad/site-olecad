<meta name="description" content="{{ description or excerpt or 'OléCAD — Partner oficial SOLIDWORKS & 3DEXPERIENCE en España y Portugal. Red Ohmycad.' }}" />
<link rel="canonical" href="https://olecad.com{{ page.url }}" />
<meta name="robots" content="index, follow, max-image-preview:large" />

<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:site_name" content="OléCAD" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description or excerpt or '' }}" />
<meta property="og:url" content="https://olecad.com{{ page.url }}" />
